parameters:
	ignoreErrors:
		-
			message: '#^Parameter &\$variables by\-ref type of method Drupal\\vvjb\\Hook\\VvjbPreprocessHooks\:\:preprocessViewsViewVvjb\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/Hook/VvjbPreprocessHooks.php

		-
			message: '#^Method Drupal\\vvjb\\Hook\\VvjbTokenHooks\:\:tokens\(\) should return array\<string, Drupal\\Core\\Render\\Markup\|string\> but returns array\<string, Drupal\\Component\\Render\\MarkupInterface\|string\>\.$#'
			identifier: return.type
			count: 1
			path: src/Hook/VvjbTokenHooks.php
